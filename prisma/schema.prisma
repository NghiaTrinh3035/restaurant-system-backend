generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  fullName      String
  email         String         @unique
  passwordHash  String?
  provider      AuthProvider   @default(LOCAL)
  providerId    String?        @unique
  phone         String?
  gender        Gender?
  avatar        String?
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
}

model RestaurantBranch {
  id        String                 @id @default(uuid()) @db.Uuid
  name      String
  address   String
  phone     String
  latitude  Float                  @db.DoublePrecision
  longitude Float                  @db.DoublePrecision
  status    RestaurantBranchStatus @default(ACTIVE)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  tables RestaurantTable[]

  @@map("restaurant_branches")
}

model TableType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  capacity    Int
  description String?

  tables RestaurantTable[]

  @@map("table_types")
}

model RestaurantTable {
  id          String                @id @default(uuid()) @db.Uuid
  tableNumber String
  floor       Int
  status      RestaurantTableStatus @default(AVAILABLE)
  note        String?

  branchId    String @db.Uuid
  tableTypeId String @db.Uuid

  branch    RestaurantBranch @relation(fields: [branchId], references: [id])
  tableType TableType        @relation(fields: [tableTypeId], references: [id])

  @@unique([branchId, tableNumber])
  @@map("restaurant_tables")
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RestaurantBranchStatus {
  ACTIVE
  INACTIVE
}

enum RestaurantTableStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}
