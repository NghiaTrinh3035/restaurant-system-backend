generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  fullName      String
  email         String         @unique
  passwordHash  String?
  provider      AuthProvider   @default(LOCAL)
  providerId    String?        @unique
  phone         String?
  gender        Gender?
  avatar        String?
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  branchId      String?        @db.Uuid
  branch        RestaurantBranch? @relation(fields: [branchId], references: [id])

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
}

model RestaurantBranch {
  id                  String                 @id @default(uuid()) @db.Uuid
  name                String
  address             String
  phone               String
  latitude            Float                  @db.DoublePrecision
  longitude           Float                  @db.DoublePrecision
  imageUrl            String?
  openingTime         String?                @default("08:00")
  closingTime         String?                @default("22:00")
  slotDurationMinutes Int                    @default(90)
  status              RestaurantBranchStatus @default(ACTIVE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  tables              RestaurantTable[]
  staff               User[]
  branchMenuItems     BranchMenuItem[]
  operatingHours      BranchOperatingHours[]

  @@map("restaurant_branches")
}

model TableType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  capacity    Int
  description String?

  tables      RestaurantTable[]

  @@map("table_types")
}

model RestaurantTable {
  id          String                @id @default(uuid()) @db.Uuid
  tableNumber String
  floor       Int
  status      RestaurantTableStatus @default(AVAILABLE)
  note        String?
  isActive    Boolean               @default(true)

  branchId    String                @db.Uuid
  tableTypeId String                @db.Uuid

  branch      RestaurantBranch      @relation(fields: [branchId], references: [id])
  tableType   TableType             @relation(fields: [tableTypeId], references: [id])

  @@unique([branchId, tableNumber])
  @@map("restaurant_tables")
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RestaurantBranchStatus {
  ACTIVE
  INACTIVE
}

enum RestaurantTableStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  DIRTY
}

model MenuCategory {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items       MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  price           Decimal      @db.Decimal(12, 2)
  originalPrice   Decimal?     @db.Decimal(12, 2)
  imageUrl        String?
  isFeatured      Boolean      @default(false)
  preparationTime Int?
  isActive        Boolean      @default(true)

  categoryId      String       @db.Uuid
  category        MenuCategory @relation(fields: [categoryId], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  branchMenuItems BranchMenuItem[]

  @@map("menu_items")
}

model BranchMenuItem {
  id            String   @id @default(uuid()) @db.Uuid
  branchId      String   @db.Uuid
  menuItemId    String   @db.Uuid
  isAvailable   Boolean  @default(true) // Còn hàng / Tạm hết hôm nay tại chi nhánh
  isActive      Boolean  @default(true) // Chi nhánh có kinh doanh món này không
  priceOverride Decimal? @db.Decimal(12, 2) // Giá riêng nếu chi nhánh có chính sách giá khác
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch        RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem      MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, menuItemId])
  @@map("branch_menu_items")
}

model BranchOperatingHours {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  dayOfWeek Int      // 0: Chủ Nhật, 1: Thứ Hai, ..., 6: Thứ Bảy
  openTime  String   @default("08:00")
  closeTime String   @default("22:00")
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("branch_operating_hours")
}
