enum InvoiceStatus {
  OPEN
  PAYMENT_PENDING
  PAID
  CANCELLED
}

enum KitchenItemStatus {
  QUEUED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderSourceType {
  DINE_IN
  PICKUP
  PRE_ORDER
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceCode    String        @unique // VD: "INV-20261113-ABCD"
  branchId       String        @db.Uuid
  tableId        String        @db.Uuid
  reservationId  String?       @db.Uuid
  userId         String?       @db.Uuid
  customerName   String        @default("Khách tại bàn")
  customerPhone  String?
  guestCount     Int           @default(1)

  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  finalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(OPEN)
  paymentMethod  String?
  notes          String?

  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch         RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table          RestaurantTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  reservation    Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  batches        OrderBatch[]

  @@index([branchId, status])
  @@index([tableId, status])
  @@index([reservationId])
  @@map("invoices")
}

model OrderBatch {
  id            String     @id @default(uuid()) @db.Uuid
  batchNumber   Int        @default(1)
  invoiceId     String     @db.Uuid
  branchId      String     @db.Uuid
  tableId       String     @db.Uuid
  orderedByRole Role       @default(USER)
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  invoice       Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  branch        RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table         RestaurantTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items         OrderItem[]

  @@index([invoiceId])
  @@index([branchId, createdAt])
  @@index([tableId])
  @@map("order_batches")
}

model OrderItem {
  id              String            @id @default(uuid()) @db.Uuid
  batchId         String            @db.Uuid
  menuItemId      String            @db.Uuid
  quantity        Int               @default(1)
  unitPrice       Decimal           @db.Decimal(12, 2)
  subtotal        Decimal           @db.Decimal(12, 2)
  note            String?

  status          KitchenItemStatus @default(QUEUED)
  preparedAt      DateTime?
  readyAt         DateTime?
  servedAt        DateTime?
  cancelledReason String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  batch           OrderBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  menuItem        MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@index([menuItemId])
  @@map("order_items")
}
